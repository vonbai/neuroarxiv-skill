{
  "name": "neuroarxiv-skill",
  "version": "0.2.0",
  "description": "A Skill-first Research Run that turns arXiv prior art into one actionable path for an open technical mechanism.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "neuroarxiv": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "arxiv",
    "research",
    "prior-art",
    "literature-review",
    "architecture",
    "agent",
    "agents",
    "ai",
    "llm",
    "skill"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vonbai/neuroarxiv-skill.git"
  },
  "homepage": "https://github.com/vonbai/neuroarxiv-skill#readme",
  "bugs": {
    "url": "https://github.com/vonbai/neuroarxiv-skill/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
